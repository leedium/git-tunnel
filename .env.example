# Copy this file to .env and edit it. .env is git-ignored.

# Easiest start: run ./scripts/setup.sh, which creates .env with a generated
# password, starts the container and prints the command for the client.

# REQUIRED unless PASSWORD_LOGIN=no. Password a client uses the first time it
# connects as "sshuser"; connect.sh then installs a key and stops asking.
# Minimum 8 characters.
# If it contains $ or #, wrap it in single quotes: SSH_PASSWORD='pa$$word#1'
SSH_PASSWORD=

# Set to "no" once your clients have connected once and have their key
# installed. Only keys are accepted after that, and SSH_PASSWORD can be removed.
PASSWORD_LOGIN=yes

# Address on the Docker host that sshd is published on. Set to 127.0.0.1 when
# the client is this same machine, so the port is not reachable from the network.
SSH_BIND=0.0.0.0

# Port sshd listens on, published on the Docker host.
SSH_PORT=2222

# Port inside the container that the client's reverse tunnel listens on.
# Never published. Must be 1024 or higher.
TUNNEL_PORT=2223

# Git server reached through the client.
GIT_HOST=github.com

# HTTP proxy inside the container, for npm install and other http(s) traffic
# that must leave the network from the client. Set to "off" to disable.
PROXY_PORT=3128

# Port inside the container for the client's reverse SOCKS tunnel, which the
# HTTP proxy forwards to. Never published. Must be 1024 or higher.
SOCKS_PORT=1080

# Optional: hosts that should NOT go through the proxy (comma separated).
# NO_PROXY=localhost,127.0.0.1,::1,registry.internal.example

# Node.js version in the image (major or exact). Rebuild after changing.
NODE_VERSION=22

# Folder on the Docker host mounted at /home/sshuser/work.
WORKSPACE_DIR=./workspace

# Optional: git identity for commits made inside the container.
GIT_USER_NAME=
GIT_USER_EMAIL=

# Optional, Linux hosts only: UID for sshuser, so workspace files match your
# host user (run `id -u`). Rebuild after changing: docker compose build
SSH_UID=1000
